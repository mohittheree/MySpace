# Copy this file to .env and fill in values from Supabase Project Settings > API.
# Use the publishable key (sb_publishable_...) or legacy anon key (eyJ...).
# Never put a service_role or sb_secret key here or in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
PORT=3000
